      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus grupos"
          }
        }
      }
    },
    "groupRules.eventDate.error.past": {
      "comment": "Error below the event date when it is before today.",

      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar"
          }
        }
      }
    },
    "createGroup.discard.keepEditing": {
      "comment": "Button that closes the discard alert and keeps the creation flow open.",

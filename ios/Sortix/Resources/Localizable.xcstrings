            "state": "translated",
            "value": "Ex.: Casa da vó"
          }
        }
      }
    },
    "groupRules.maxValue.error.tooHigh": {
      "comment": "Error below the maximum value when it is above the limit. %@ is the formatted limit, such as R$ 100.000,00.",

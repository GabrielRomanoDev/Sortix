{
  "sourceLanguage": "pt-BR",
  "strings": {
    "about.button.accessibilityLabel": {
      "comment": "Accessibility label of the info button that opens the About menu on the group list.",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre o app"
          }
        }
      }
    },
    "about.menu.privacy": {
      "comment": "About menu item that opens the privacy policy page.",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Política de privacidade"
          }
        }
      }
    },
    "about.menu.support": {
      "comment": "About menu item that opens the help and support page.",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuda e suporte"
          }
        }
      }
    },
    "about.menu.version": {
      "comment": "Disabled About menu item showing the app version. %@ is the version number, such as 1.0.",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Versão %@"
          }
        }
      }
    },
    "common.action.cancel": {
      "comment": "Button that cancels the current flow or dialog.",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        }
      }
    },
    "common.action.delete": {
      "comment": "Destructive button that deletes an item after confirmation.",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir"
          }
        }
      }
    },
    "common.action.done": {
      "comment": "Button that closes an informational dialog.",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "common.action.next": {
      "comment": "Button that moves to the next step of a flow.",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Próximo"
          }
        }
      }
    },
    "common.action.retry": {
      "comment": "Button that repeats an operation that failed.",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentar novamente"
          }
        }
      }
    },
    "common.action.save": {
      "comment": "Button that saves the changes of a form.",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar"
          }
        }
      }
    },
    "common.discardChanges.confirm": {
      "comment": "Destructive button that closes a form and discards its unsaved changes.",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar"
          }
        }
      }
    },
    "common.discardChanges.title": {
      "comment": "Title of the confirmation shown when closing a form with unsaved changes.",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar alterações?"
          }
        }
      }
    },
    "common.error.generic.message": {
      "comment": "Message shown when an operation fails for an unexpected reason.",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado. Tente de novo em instantes."
          }
        }
      }
    },
    "common.error.network.message": {
      "comment": "Message shown when an operation fails because there is no internet connection.",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique sua internet e tente de novo."
          }
        }
      }
    },
    "common.error.network.title": {
      "comment": "Title shown when an operation fails because there is no internet connection.",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conexão"
          }
        }
      }
    },
    "common.invalidLink.message": {
      "comment": "Message shown when a personal or recovery link no longer works, explaining the likely causes.",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este link não é mais válido. Ele pode ter sido digitado errado ou o grupo foi excluído pelo organizador."
          }
        }
      }
    },
    "common.invalidLink.title": {
      "comment": "Title shown when a personal or recovery link no longer works.",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Link inválido"
          }
        }
      }
    },
    "createGroup.discard.confirm": {
      "comment": "Destructive button that discards the group being created.",

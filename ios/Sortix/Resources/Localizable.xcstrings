      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar editando"
          }
        }
      }
    },
    "createGroup.discard.message": {
      "comment": "Message of the alert shown when leaving the creation flow with data filled in.",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados preenchidos serão perdidos."
          }
        }
      }
    },
    "createGroup.discard.title": {
      "comment": "Title of the alert shown when leaving the creation flow with data filled in.",
